      <data key="d0">主要围手术期并发症</data>
      <data key="d1">event</data>
      <data key="d2">结直肠手术患者在围手术期发生的严重不良事件，其发生风险与高NLR水平相关。</data>
      <data key="d3">doc-4180dc15539d4d9624b6d451fee4b88d-chunk-000</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1787633220</data>
      <data key="d6" />
    </node>
    <node id="结直肠手术患者">
      <data key="d0">结直肠手术患者</data>
      <data key="d1">person</data>
      <data key="d2">接受结直肠手术的个体，是本研究评估NLR预测价值的对象。</data>
      <data key="d3">doc-4180dc15539d4d9624b6d451fee4b88d-chunk-000</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1787633220</data>
      <data key="d6" />
    </node>
    <node id="吻合口高度">
      <data key="d0">吻合口高度</data>
      <data key="d1">concept</data>
      <data key="d2">该研究报告指出吻合口高度是显著影响吻合口漏发生的因素之一，但未提供效应量。</data>
      <data key="d3">doc-ee66903c97d5199a8ad5f013d0eb9646-chunk-000</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1787633253</data>
