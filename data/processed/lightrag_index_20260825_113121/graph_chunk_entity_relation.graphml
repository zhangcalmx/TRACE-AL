    <node id="Robotic Single-Port Trans-stomal Hartmann Reversal">
      <data key="d0">Robotic Single-Port Trans-stomal Hartmann Reversal</data>
      <data key="d1">content</data>
      <data key="d2">一篇关于机器人单孔经造口哈特曼逆转术的PubMed摘要文章，标题为“Robotic Single-Port Trans-stomal Hartmann Reversal”，其证据级别为B级。</data>
      <data key="d3">doc-7e7e205646a4487b32b8fb56fcc47c4b-chunk-000</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1787635551</data>
      <data key="d6" />
    </node>
    <node id="直肠横断技术参数">
      <data key="d0">直肠横断技术参数</data>
      <data key="d1">concept</data>
      <data key="d2">指在直肠横断过程中使用的技术相关参数，这些参数可能影响吻合口的完整性。</data>
      <data key="d3">doc-7e7e205646a4487b32b8fb56fcc47c4b-chunk-000</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1787635583</data>
      <data key="d6" />
    </node>
    <node id="文献">
      <data key="d0">文献</data>
      <data key="d1">content</data>
      <data key="d2">指包含相关研究和数据的学术文献集合，用于支持或反驳关于吻合器击发次数与吻合口漏关系的观点。</data>
      <data key="d3">doc-7e7e205646a4487b32b8fb56fcc47c4b-chunk-000</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1787635583</data>
      <data key="d6" />
    </node>
    <node id="术前胰岛素抵抗替代指标">
      <data key="d0">术前胰岛素抵抗替代指标</data>
      <data key="d1">concept</data>
      <data key="d2">用于评估患者术前胰岛素抵抗状态的替代性指标，与结直肠癌术后吻合口漏风险相关。</data>
      <data key="d3">doc-c283b10a254804831af7dd1dbcc096f8-chunk-000</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1787635583</data>
      <data key="d6" />
    </node>
    <node id="结直肠癌切除术">
      <data key="d0">结直肠癌切除术</data>
      <data key="d1">event</data>
      <data key="d2">针对结直肠癌患者进行的外科切除手术，术后可能发生吻合口漏并发症。</data>
      <data key="d3">doc-c283b10a254804831af7dd1dbcc096f8-chunk-000</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1787635583</data>
      <data key="d6" />
    </node>
    <node id="代谢状态">
      <data key="d0">代谢状态</data>
      <data key="d1">concept</data>
      <data key="d2">患者机体的代谢状况，包括胰岛素抵抗等，影响吻合口愈合过程。</data>
      <data key="d3">doc-c283b10a254804831af7dd1dbcc096f8-chunk-000</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1787635583</data>
      <data key="d6" />
    </node>
    <node id="PMID:42026671">
      <data key="d0">PMID:42026671</data>
      <data key="d1">content</data>
      <data key="d2">PubMed文献标识号，对应一篇关于术前胰岛素抵抗替代指标与结直肠癌术后吻合口漏风险关联的多中心回顾性队列研究摘要。</data>
      <data key="d3">doc-c283b10a254804831af7dd1dbcc096f8-chunk-000</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1787635583</data>
      <data key="d6" />
    </node>
    <node id="日本NCD数据库ML预测模型">
      <data key="d0">日本NCD数据库ML预测模型</data>
      <data key="d1">content</data>
      <data key="d2">一项基于日本全国临床数据库的研究，旨在利用机器学习模型预测直肠癌低位前切除术后吻合口漏(AL)的发生风险。</data>
      <data key="d3">doc-0661bc5e64826fc725fa375b5cac942e-chunk-000</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1787635842</data>
      <data key="d6" />
    </node>
    <node id="日本全国临床数据库">
      <data key="d0">日本全国临床数据库</data>
      <data key="d1">data</data>
      <data key="d2">日本全国性的临床数据库，收录了2015至2021年间接受直肠癌低位前切除的患者数据，共纳入119818例病例。&lt;SEP&gt;日本全国临床数据库是用于分析LAR手术病例的全国性临床数据库，包含119818例LAR手术数据，用于评估吻合口漏的预测模型性能。</data>
      <data key="d3">doc-0661bc5e64826fc725fa375b5cac942e-chunk-000&lt;SEP&gt;doc-9a4550c8d57adcdda6b44adb318f7412-chunk-000</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1787636635</data>
      <data key="d6" />
    </node>
    <node id="直肠癌低位前切除患者">
      <data key="d0">直肠癌低位前切除患者</data>
      <data key="d1">person</data>
      <data key="d2">2015至2021年间在日本全国临床数据库中登记、接受直肠癌低位前切除手术的119818名患者群体。</data>
      <data key="d3">doc-0661bc5e64826fc725fa375b5cac942e-chunk-000</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1787635842</data>
      <data key="d6" />
    </node>
    <node id="逻辑回归">
      <data key="d0">逻辑回归</data>
      <data key="d1">method</data>
      <data key="d2">一种用于预测术前吻合口漏风险的机器学习模型，在验证队列中的AUROC约为0.63。&lt;SEP&gt;逻辑回归是一种统计学习方法，在本研究中用于预测LAR术后吻合口漏的发生，验证集AUROC约为0.63。</data>
      <data key="d3">doc-0661bc5e64826fc725fa375b5cac942e-chunk-000&lt;SEP&gt;doc-9a4550c8d57adcdda6b44adb318f7412-chunk-000</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1787636637</data>
      <data key="d6" />
    </node>
    <node id="Lasso">
      <data key="d0">Lasso</data>
      <data key="d1">method</data>
      <data key="d2">一种用于预测术前吻合口漏风险的机器学习模型，在验证队列中的AUROC约为0.63。&lt;SEP&gt;Lasso是一种正则化线性回归方法，在本研究中用于预测LAR术后吻合口漏，验证集AUROC约为0.63。</data>
      <data key="d3">doc-0661bc5e64826fc725fa375b5cac942e-chunk-000&lt;SEP&gt;doc-9a4550c8d57adcdda6b44adb318f7412-chunk-000</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1787636637</data>
      <data key="d6" />
    </node>
    <node id="XGBoost">
      <data key="d0">XGBoost</data>
      <data key="d1">method</data>
      <data key="d2">一种用于预测术前吻合口漏风险的机器学习模型，在验证队列中的AUROC约为0.63。&lt;SEP&gt;XGBoost是一种梯度提升机器学习算法，在本研究中用于预测LAR术后吻合口漏，验证集AUROC约为0.63。</data>
      <data key="d3">doc-0661bc5e64826fc725fa375b5cac942e-chunk-000&lt;SEP&gt;doc-9a4550c8d57adcdda6b44adb318f7412-chunk-000</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1787636670</data>
      <data key="d6" />
    </node>
    <node id="术前AL预测">
      <data key="d0">术前AL预测</data>
      <data key="d1">concept</data>
      <data key="d2">基于术前数据对吻合口漏(AL)发生风险的预测能力，研究结论认为该预测能力不理想。</data>
      <data key="d3">doc-0661bc5e64826fc725fa375b5cac942e-chunk-000</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1787635842</data>
      <data key="d6" />
    </node>
    <node id="ICG-COLORAL芬兰RCT">
      <data key="d0">ICG-COLORAL芬兰RCT</data>
      <data key="d1">event</data>
      <data key="d2">芬兰开展的一项多中心随机对照试验，旨在评估吲哚菁绿(ICG)在结直肠手术中对吻合口漏(AL)风险的降低作用。</data>
      <data key="d3">doc-06d007d1613b8b370f4d9c99ae580c0a-chunk-000</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1787635842</data>
      <data key="d6" />
    </node>
    <node id="对照组">
      <data key="d0">对照组</data>
      <data key="d1">concept</data>
      <data key="d2">试验中未接受吲哚菁绿荧光成像辅助手术的患者组别。&lt;SEP&gt;在荟萃分析中未接受ICG干预的对照组患者，其并发症发生率为8.6%。</data>
      <data key="d3">doc-06d007d1613b8b370f4d9c99ae580c0a-chunk-000&lt;SEP&gt;doc-73c1f78628cd4012f3d1658dc6eccb95-chunk-000</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1787636670</data>
      <data key="d6" />
    </node>
    <node id="意向治疗人群">
      <data key="d0">意向治疗人群</data>
      <data key="d1">concept</data>
      <data key="d2">试验中按随机分组进行统计分析的全部1136例患者群体。</data>
      <data key="d3">doc-06d007d1613b8b370f4d9c99ae580c0a-chunk-000</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1787635844</data>
      <data key="d6" />
    </node>
    <node id="左侧手术亚组">
      <data key="d0">左侧手术亚组</data>
      <data key="d1">concept</data>
      <data key="d2">试验中接受左侧结肠或直肠手术的患者亚组，显示可能受益的趋势。</data>
      <data key="d3">doc-06d007d1613b8b370f4d9c99ae580c0a-chunk-000</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1787635844</data>
      <data key="d6" />
    </node>
    <node id="AL率">
      <data key="d0">AL率</data>
      <data key="d1">data</data>
      <data key="d2">吻合口漏发生率，试验中ICG组为5.8%，对照组为7.9%。</data>
      <data key="d3">doc-06d007d1613b8b370f4d9c99ae580c0a-chunk-000</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1787635844</data>
      <data key="d6" />
    </node>
    <node id="RALAR意大利多中心研究">
      <data key="d0">RALAR意大利多中心研究</data>
      <data key="d1">content</data>
      <data key="d2">一项意大利全国性多中心回顾性研究，涉及24个转诊中心，纳入5398例直肠癌手术患者，报告总吻合口漏(AL)率为10.2%，并分析独立风险因素。</data>
      <data key="d3">doc-f3722a0c74393d47cc4abad6ca863974-chunk-000</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1787635878</data>
