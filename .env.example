# Optional runtime configuration. Offline rules and local evidence retrieval do
# not require any API key. Copy to .env only when an approved provider may be used.

# Chat is explanatory only and never changes deterministic risk levels.
# Do not send patient-level data to an unapproved external API.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# The manuscript denotes the deployed chat model snapshot as DeepSeek-V4-Flash-0731.
DEEPSEEK_CHAT_MODEL=deepseek-v4-flash


# Ark embedding: use only after evidence/citation gates pass.
ARK_API_KEY=
ARK_CHAT_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# Pin an exact model or endpoint ID; do not use latest/auto aliases in validation.
ARK_CHAT_MODEL=
ARK_EMBED_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_EMBED_ENDPOINT_ID=
ARK_EMBED_MODEL=doubao-embedding-vision-251215
ARK_EMBED_DIM=2048
ARK_EMBED_CONCURRENCY=8

# Normally resolved from data/processed/lightrag_current.json after acceptance.
LIGHTRAG_WORKING_DIR=

# Non-clinical provider probe/model-sensitivity configuration lives in
# configs/pure_llm_models.yaml. Never commit a credential or send patient-level
# data through the Coding Plan gateway.

# Optional NCBI key for future source-metadata verification.
NCBI_API_KEY=
