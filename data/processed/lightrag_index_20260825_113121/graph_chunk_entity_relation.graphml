    <node id="右半结肠吻合口漏率">
      <data key="d0">右半结肠吻合口漏率</data>
      <data key="d1">data</data>
      <data key="d2">反映右半结肠手术后吻合口漏发生情况的指标，总体干预前后分别为10.1%和9.6%。</data>
      <data key="d3">doc-cbbf91f70cf9f0c79b354c902ce1e035-chunk-000</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1787628897</data>
