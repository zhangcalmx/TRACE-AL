      <data key="d0">缝合修补</data>
      <data key="d1">method</data>
      <data key="d2">针对阳性漏试验结果的一种补救措施，用于修复吻合口缺陷。</data>
      <data key="d3">doc-8c763e0375bc7095cff36c1f71df8792-chunk-000</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1787629073</data>
      <data key="d6" />
