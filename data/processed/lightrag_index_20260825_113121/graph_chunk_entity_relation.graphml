      <data key="d2">Nugent是2021年发表的一项关于肥胖与结直肠癌术后吻合口漏(AL)关系的荟萃分析的研究者，该研究发表于PubMed，编号为PMID:33796958。</data>
      <data key="d3">doc-afa25ced3cdf3b8643cdf99fa84c68bd-chunk-000</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1787635501</data>
      <data key="d6" />
    </node>
    <node id="结直肠癌术后吻合口漏(AL)">
      <data key="d0">结直肠癌术后吻合口漏(AL)</data>
      <data key="d1">concept</data>
      <data key="d2">吻合口漏(AL)是结直肠癌术后的一种严重并发症，本研究关注肥胖是否增加其发生风险。</data>
      <data key="d3">doc-afa25ced3cdf3b8643cdf99fa84c68bd-chunk-000</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1787635501</data>
      <data key="d6" />
    </node>
    <node id="PMID:33796958">
      <data key="d0">PMID:33796958</data>
      <data key="d1">content</data>
      <data key="d2">PMID:33796958是Nugent等人于2021年发表的关于肥胖与结直肠癌术后吻合口漏(AL)荟萃分析的PubMed文献标识符。</data>
      <data key="d3">doc-afa25ced3cdf3b8643cdf99fa84c68bd-chunk-000</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1787635501</data>
      <data key="d6" />
    </node>
    <node id="DOI:10.1007/s00384-021-03909-7">
      <data key="d0">DOI:10.1007/s00384-021-03909-7</data>
      <data key="d1">content</data>
      <data key="d2">DOI:10.1007/s00384-021-03909-7是Nugent等人2021年荟萃分析论文的数字对象标识符，用于唯一标识该文献。</data>
      <data key="d3">doc-afa25ced3cdf3b8643cdf99fa84c68bd-chunk-000</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1787635501</data>
      <data key="d6" />
