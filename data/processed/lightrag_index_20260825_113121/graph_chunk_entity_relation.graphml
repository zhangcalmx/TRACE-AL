    <node id="Litchinko">
      <data key="d0">Litchinko</data>
      <data key="d1">person</data>
      <data key="d2">Litchinko是2024年发表系统综述的研究者，其研究发表于PMID:38418633。</data>
      <data key="d3">doc-d04f8c6e683d933622865e9eb31e8100-chunk-000</data>
