    <node id="液体过负荷">
      <data key="d0">液体过负荷</data>
      <data key="d1">concept</data>
      <data key="d2">指手术日液体输入过多导致体重过度增加的状态，指南认为液体过量可能带来不良结局。</data>
      <data key="d3">doc-47c6e69a3318bb970856ef4d65e745ff-chunk-000</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1787631539</data>
