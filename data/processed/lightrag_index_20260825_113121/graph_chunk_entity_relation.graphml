    </node>
    <node id="高参与中心">
      <data key="d0">高参与中心</data>
      <data key="d1">concept</data>
      <data key="d2">参与度较高的研究中心，其吻合口漏率由干预前的12.2%降至干预后的5.1%。</data>
      <data key="d3">doc-cbbf91f70cf9f0c79b354c902ce1e035-chunk-000</data>
      <data key="d4">unknown_source</data>
