      <data key="d1">concept</data>
      <data key="d2">机体对损伤或感染的防御反应，在吻合口漏形成和吻合愈合中发挥重要作用。</data>
      <data key="d3">doc-3892abdd0567575131bc0c7429a015f9-chunk-000</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1787631620</data>
      <data key="d6" />
    </node>
