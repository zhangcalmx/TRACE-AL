    </node>
    <node id="24个转诊中心">
      <data key="d0">24个转诊中心</data>
      <data key="d1">organization</data>
      <data key="d2">参与该回顾性研究的意大利全国24个转诊中心，共同提供直肠癌手术患者数据。</data>
      <data key="d3">doc-f3722a0c74393d47cc4abad6ca863974-chunk-000</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1787635878</data>
      <data key="d6" />
