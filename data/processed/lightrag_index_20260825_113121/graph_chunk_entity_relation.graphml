      <data key="d0">随机对照研究</data>
      <data key="d1">event</data>
      <data key="d2">比较目标导向与常规液体治疗对老年结直肠癌患者术后认知功能障碍影响的临床试验设计。</data>
      <data key="d3">doc-51ae825974a224bdc223862f8b816240-chunk-000</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1787634001</data>
      <data key="d6" />
    </node>
    <node id="个体化术中血压控制">
      <data key="d0">个体化术中血压控制</data>
      <data key="d1">method</data>
      <data key="d2">术中根据患者个体情况调整血压的管理策略，与去甲肾上腺素给药相关。</data>
      <data key="d3">doc-51ae825974a224bdc223862f8b816240-chunk-000</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1787634001</data>
