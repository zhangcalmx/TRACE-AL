    <node id="5398例直肠癌手术患者">
      <data key="d0">5398例直肠癌手术患者</data>
      <data key="d1">data</data>
      <data key="d2">该研究纳入的直肠癌手术患者总数，用于统计总吻合口漏率及风险因素分析。</data>
      <data key="d3">doc-f3722a0c74393d47cc4abad6ca863974-chunk-000</data>
      <data key="d4">unknown_source</data>
