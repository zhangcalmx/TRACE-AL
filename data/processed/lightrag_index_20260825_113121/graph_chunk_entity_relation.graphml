      <data key="d1">location</data>
      <data key="d2">开展该多中心研究的国家，研究覆盖全国24个转诊中心。</data>
      <data key="d3">doc-f3722a0c74393d47cc4abad6ca863974-chunk-000</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1787635878</data>
