    <node id="术中诊断技术综述">
      <data key="d0">术中诊断技术综述</data>
      <data key="d1">content</data>
      <data key="d2">一篇叙述性综述，讨论术中吻合口完整性评估方法，包括充气试验、术中内镜、Doppler超声和近红外荧光成像。</data>
      <data key="d3">doc-8017c9b2178a2a3d5bc53dac50004ff3-chunk-000</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1787638003</data>
